# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
venv/
.venv/

# Environment
.env
.env.*
!.env.example

# Streamlit secrets (never commit real secrets)
.streamlit/secrets.toml

# NOTE: Model artifacts and data files ARE committed for Streamlit Cloud deployment.
# Uncomment the lines below if you want to exclude them from Git again.
# models/*.pkl
# models/*.faiss
# models/*.index
# data/processed/*.csv
# data/raw/*.csv

# Keep folder structure visible on GitHub even though contents are ignored
!models/.gitkeep
!data/processed/.gitkeep
!data/raw/.gitkeep

# Runtime output
outputs/*
!outputs/.gitkeep

# OS files
.DS_Store
Thumbs.db

# VS Code
.vscode/*
!.vscode/settings.json
